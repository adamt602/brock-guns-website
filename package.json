{
  "name": "brock-guns-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Brock Guns and Repair LLC \u2014 Astro + TypeScript frontend",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:links": "node scripts/check-links.mjs",
    "test:layout": "node scripts/check-layout.mjs",
    "verify": "npm run check && npm run lint && npm run format:check && npm run build && npm run test:links"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
