# Production URL of the site (enables canonical URLs). Not yet verified.
SITE_URL=

# Sub-path the site is served from, e.g. /my-repo for a GitHub Pages project
# site. Leave empty when the site is at the root of its domain.
BASE_PATH=

# Endpoint that accepts contact form submissions as JSON (POST).
# Leave empty until a backend exists: the form then tells visitors plainly
# that it is not connected and points them to the phone number.
PUBLIC_CONTACT_FORM_ENDPOINT=
