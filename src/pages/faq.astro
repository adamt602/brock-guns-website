---
import FaqSection from '@/components/faq/FaqSection.astro';
import ContactCallout from '@/components/sections/ContactCallout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { routes } from '@/config/routes';
import { site } from '@/config/site';
import { faqGroups } from '@/data/faqs';
import PageLayout from '@/layouts/PageLayout.astro';
import { visibleFaqGroups } from '@/lib/content/visibleFaqs';

const groups = visibleFaqGroups(faqGroups, site.showPendingContent);
---

<PageLayout
  title="Questions and Answers"
  description="Short answers to common questions about Brock Guns and Repair: contacting the shop, services, repairs and product availability."
>
  <PageHero
    heading="Questions and Answers"
    description="Short answers to common questions. If yours is not here, the fastest way to get it answered is to call David."
    breadcrumbs={[{ label: 'Home', href: routes.home }, { label: 'FAQ' }]}
  />
  <FaqSection groups={groups} />
  <ContactCallout />
</PageLayout>
