---
import TextLink from '@/components/ui/TextLink.astro';
import type { FaqGroup } from '@/types/faq';

/** Jump links to each FAQ topic. */
interface Props {
  groups: FaqGroup[];
}

const { groups } = Astro.props;
---

<nav class="faq-topics" aria-label="FAQ topics">
  <p class="text-eyebrow faq-topics__heading">Topics</p>
  {groups.map((group) => (
    <TextLink href={`#${group.id}`} underline={false}>
      {group.title}
    </TextLink>
  ))}
</nav>

<style>
  .faq-topics {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: var(--space-5) var(--space-6);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .faq-topics__heading {
    margin-bottom: var(--space-2);
    color: var(--color-brass-dark);
  }
</style>
