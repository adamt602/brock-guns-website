---
import CallButton from '@/components/contact/CallButton.astro';
import Button from '@/components/ui/Button.astro';
import ButtonGroup from '@/components/ui/ButtonGroup.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { routes } from '@/config/routes';
import { business, phoneHref } from '@/data/business';

/** Closing "Talk to David" call-to-action shared by most pages. */
interface Props {
  heading?: string;
  description?: string;
}

const {
  heading = `Talk to ${business.owner.firstName}`,
  description = `Questions about an item or a service? Call ${business.owner.name} directly.`,
} = Astro.props;
---

<Section tone="ivory" space="none" border="top" aria-labelledby="contact-callout-heading">
  <div class="contact-callout__inner">
    <span class="contact-callout__rule" aria-hidden="true"></span>
    <SectionHeading
      id="contact-callout-heading"
      eyebrow="Contact"
      heading={heading}
      display
      class="contact-callout__heading"
    />
    <p class="contact-callout__description">{description}</p>
    <a class="contact-callout__phone tabular-nums" href={phoneHref}>
      {business.phone.display}
    </a>
    <div class="contact-callout__actions">
      <ButtonGroup align="center">
        <CallButton variant="primary" />
        <Button variant="outline" href={routes.contact}>
          Send a Message
        </Button>
      </ButtonGroup>
    </div>
  </div>
</Section>

<style>
  .contact-callout__inner {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    text-align: center;
  }

  .contact-callout__rule {
    display: block;
    width: 3rem;
    height: 2px;
    background: var(--color-brass);
  }

  .contact-callout__inner :global(.contact-callout__heading) {
    align-items: center;
    margin-top: 0.375rem;
  }

  .contact-callout__description {
    max-width: 27.5rem;
    color: var(--color-text-muted);
  }

  .contact-callout__phone {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-size: var(--text-phone);
    line-height: 1.15;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.03em;
    color: var(--color-navy);
    text-decoration: none;
  }

  .contact-callout__actions {
    width: 100%;
    max-width: 27.5rem;
    padding-top: 0.625rem;
  }
</style>
