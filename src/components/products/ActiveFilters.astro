---
import Chip from '@/components/ui/Chip.astro';
import TextLink from '@/components/ui/TextLink.astro';

/**
 * Row of removable chips for the filters currently applied. Hidden until a
 * filter is active. The <template> holds one server-rendered chip that
 * `inventoryFilters.ts` clones, so the chip markup lives only in Chip.astro.
 */
---

<div class="active-filters" data-active-filters hidden>
  <div class="active-filters__list" data-active-list></div>
  <TextLink class="active-filters__clear" data-filter-clear>
    Clear all
  </TextLink>
  <template data-active-template>
    <Chip variant="compact" iconEnd="close" data-active-chip>
      <span data-active-label></span>
    </Chip>
  </template>
</div>

<style>
  .active-filters,
  .active-filters__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .active-filters :global(.active-filters__clear) {
    padding-inline: 0.375rem;
    font-size: var(--text-base-sm);
  }
</style>
