---
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import type { ProductImage } from '@/types/product';

/**
 * The 4:3 image well for a product. Shows the photo when one exists and a
 * neutral placeholder when it does not. Overlays (tags, badges) go in the slot.
 */
interface Props {
  image?: ProductImage;
  /** Extra line under the placeholder label, e.g. "1 of 4 · Full view". */
  caption?: string;
  /** `sizes` attribute for the real image. */
  sizes?: string;
  /** Larger placeholder icon and rounded frame, for the detail page. */
  framed?: boolean;
  class?: string;
}

const {
  image,
  caption,
  sizes = '(min-width: 1150px) 25vw, (min-width: 900px) 33vw, (min-width: 430px) 50vw, 100vw',
  framed = false,
  class: className,
  ...rest
} = Astro.props;
---

<div class:list={['product-image', { 'product-image--framed': framed }, className]} {...rest}>
  <slot />
  {image ? (
    typeof image.src === 'string' ? (
      <img
        class="product-image__photo"
        src={image.src}
        alt={image.alt}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Image
        class="product-image__photo"
        src={image.src}
        alt={image.alt}
        widths={[320, 480, 640, 960]}
        sizes={sizes}
      />
    )
  ) : (
    <span class="product-image__placeholder">
      <Icon name="image" size={framed ? 36 : 28} />
      <span>Product photo</span>
      {caption && <span class="product-image__caption">{caption}</span>}
    </span>
  )}
</div>

<style>
  .product-image {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-media);
    color: var(--color-text-muted);
  }

  .product-image--framed {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .product-image__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-image__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-md);
    font-weight: var(--font-weight-medium);
  }

  .product-image__caption {
    font-weight: var(--font-weight-regular);
  }
</style>
