---
import Chip from '@/components/ui/Chip.astro';
import { ANY } from '@/lib/products/filterOptions';
import type { Category } from '@/types/product';

/** Horizontally scrolling category filter. */
interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
const options = [
  { value: ANY, label: 'All' },
  ...categories.map((c) => ({ value: c.id, label: c.label })),
];
---

<div class="category-chips" role="group" aria-label="Category">
  {options.map((option) => (
    <Chip pressed={option.value === ANY} data-filter-chip="category" data-value={option.value}>
      {option.label}
    </Chip>
  ))}
</div>

<style>
  .category-chips {
    display: flex;
    gap: var(--space-2);
    max-width: var(--content-width);
    margin-inline: auto;
    padding: 0.375rem var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .category-chips::-webkit-scrollbar {
    display: none;
  }
</style>
