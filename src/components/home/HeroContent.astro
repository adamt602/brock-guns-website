---
/** Hero copy: eyebrow, display heading with an accented second phrase, lede. */
interface Props {
  eyebrow: string;
  headingLead: string;
  headingAccent: string;
  description: string;
  /** id for the heading (for aria-labelledby on the section). */
  headingId: string;
}

const { eyebrow, headingLead, headingAccent, description, headingId } = Astro.props;
---

<div class="hero-content">
  <p class="text-eyebrow hero-content__eyebrow">{eyebrow}</p>
  <h1 id={headingId} class="font-display text-hero">
    {headingLead} <span class="hero-content__accent">{headingAccent}</span>
  </h1>
  <p class="text-lede hero-content__description">{description}</p>
  <slot />
</div>

<style>
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .hero-content__eyebrow,
  .hero-content__accent {
    color: var(--color-brass-light);
  }

  .hero-content__description {
    max-width: 32.5rem;
    color: var(--color-on-dark-muted);
  }
</style>
