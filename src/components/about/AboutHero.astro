---
import CallButton from '@/components/contact/CallButton.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import ButtonGroup from '@/components/ui/ButtonGroup.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import OwnerProfile from './OwnerProfile.astro';
import { routes } from '@/config/routes';
import { aboutHero } from '@/data/about';

/** About page header: introduction beside the owner's portrait. */
---

<Section tone="navy" space="none" aria-labelledby="page-heading">
  <div class="about-hero">
    <div class="about-hero__content">
      <Breadcrumbs items={[{ label: 'Home', href: routes.home }, { label: 'About' }]} tone="dark" />
      <SectionHeading
        id="page-heading"
        level="h1"
        size="h1"
        display
        tone="dark"
        eyebrow={aboutHero.eyebrow}
        heading={aboutHero.heading}
      />
      <p class="about-hero__description">{aboutHero.description}</p>
      <div class="about-hero__actions">
        <ButtonGroup>
          <CallButton variant="light" />
          <Button variant="outline-light" href={routes.inventory}>
            Browse Inventory
          </Button>
        </ButtonGroup>
      </div>
    </div>
    <OwnerProfile />
  </div>
</Section>

<style>
  .about-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(2.25rem, 5vw, 5rem);
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }

  .about-hero__content {
    flex: 1.2 1 27.5rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .about-hero__description {
    max-width: 35rem;
    font-size: var(--text-lg);
    color: var(--color-on-dark-muted);
  }

  .about-hero__actions {
    width: 100%;
    padding-top: 0.375rem;
  }

  .about-hero > :global(.owner-profile) {
    flex: 1 1 21.25rem;
    min-width: 0;
  }
</style>
