---
import Badge from '@/components/ui/Badge.astro';
import { site } from '@/config/site';
import type { UnconfirmedServices } from '@/types/service';

/**
 * Development-only panel listing services the owner has not confirmed.
 * Renders nothing once `site.showPendingContent` is false.
 */
interface Props {
  content: UnconfirmedServices;
}

const { content } = Astro.props;
---

{site.showPendingContent && (
  <div class="unconfirmed">
    <Badge tone="pending">Optional module · hidden until verified</Badge>
    <h2 class="unconfirmed__heading">{content.heading}</h2>
    <p class="unconfirmed__description">{content.description}</p>
    <ul class="unconfirmed__list">
      {content.items.map((item) => (
        <li>
          <Badge tone="pending">{item.note}</Badge>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .unconfirmed {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1.5px dashed var(--color-brass);
    border-radius: var(--radius-xl);
  }

  .unconfirmed__heading {
    font-size: 1.375rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
  }

  .unconfirmed__description {
    max-width: 45rem;
    color: var(--color-text-muted);
  }

  .unconfirmed__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
