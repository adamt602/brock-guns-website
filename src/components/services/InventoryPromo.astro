---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { routes } from '@/config/routes';

/** Reminds service-page visitors that sales are the main business. */
---

<section class="inventory-promo" aria-label="Shopping for a firearm">
  <Container>
    <a class="inventory-promo__card" href={routes.inventory}>
      <span class="inventory-promo__text">
        <span class="text-eyebrow inventory-promo__eyebrow">Shopping for a firearm?</span>
        <span class="inventory-promo__heading">
          Sales are the main business. Start in Inventory.
        </span>
      </span>
      <Button decorative class="inventory-promo__button" iconEnd="arrow-right">
        Browse Inventory
      </Button>
    </a>
  </Container>
</section>

<style>
  .inventory-promo {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    background: var(--color-ivory);
  }

  .inventory-promo__card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-8);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform var(--duration-base) var(--ease),
      box-shadow var(--duration-base) var(--ease);
  }

  .inventory-promo__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-soft);
    color: var(--color-text);
  }

  .inventory-promo__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .inventory-promo__eyebrow {
    color: var(--color-brass-dark);
  }

  .inventory-promo__heading {
    font-size: clamp(1.25rem, 0.6vw + 1.125rem, 1.625rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .inventory-promo .inventory-promo__button {
    min-height: 3rem;
  }
</style>
