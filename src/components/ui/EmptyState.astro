---
import Icon from './Icon.astro';
import type { IconName } from './icons';

/** Shown in place of a list that has no results. Actions go in the slot. */
interface Props {
  heading: string;
  description: string;
  icon?: IconName;
  /** Use h1 when the empty state is the page's main heading. */
  headingLevel?: 'h1' | 'h2';
  class?: string;
  [attribute: string]: unknown;
}

const {
  heading,
  description,
  icon = 'search',
  headingLevel: Heading = 'h2',
  class: className,
  ...rest
} = Astro.props;
---

<div class:list={['empty-state', className]} {...rest}>
  <span class="empty-state__icon">
    <Icon name={icon} size={34} />
  </span>
  <Heading class="empty-state__heading">{heading}</Heading>
  <p class="empty-state__description">{description}</p>
  <div class="empty-state__actions">
    <slot />
  </div>
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-12) var(--space-6);
    text-align: center;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .empty-state__icon {
    color: var(--color-brass-dark);
  }

  .empty-state__heading {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
  }

  .empty-state__description {
    max-width: 26.25rem;
    color: var(--color-text-muted);
  }

  .empty-state__actions {
    width: 100%;
    max-width: 26.25rem;
    padding-top: var(--space-2);
  }
</style>
