---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { IconName } from './icons';

/** An inline call-to-action link with the brass underline. */
interface Props extends Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type'> {
  /** Omit to render a <button> styled as a link (for actions). */
  href?: string;
  tone?: 'default' | 'on-dark';
  underline?: boolean;
  iconStart?: IconName;
  iconEnd?: IconName;
}

const {
  href,
  tone = 'default',
  underline = true,
  iconStart,
  iconEnd,
  class: className,
  ...rest
} = Astro.props;
const Element = href ? 'a' : 'button';
const elementProps = href ? { href } : { type: 'button' as const };
---

<Element
  class:list={['text-link', `text-link--${tone}`, { 'text-link--plain': !underline }, className]}
  {...elementProps}
  {...rest}
>
  {iconStart && <Icon name={iconStart} />}
  <slot />
  {iconEnd && <Icon name={iconEnd} size={16} class="text-link__arrow" />}
</Element>

<style>
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: var(--touch-target);
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-brass);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease);
  }

  .text-link:hover {
    color: var(--color-brass-dark);
    text-decoration-color: var(--color-brass-dark);
  }

  .text-link--plain {
    text-decoration: none;
  }

  .text-link--on-dark {
    color: var(--color-white);
    text-decoration-color: var(--color-brass-light);
  }

  .text-link--on-dark:hover {
    color: var(--color-brass-pale);
    text-decoration-color: var(--color-brass-pale);
  }

  .text-link :global(.text-link__arrow) {
    transition: transform var(--duration-fast) var(--ease);
  }

  .text-link:hover :global(.text-link__arrow) {
    transform: translateX(3px);
  }
</style>
