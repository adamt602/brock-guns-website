---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  /** Rendered width and height in pixels. */
  size?: number;
  class?: string;
}

const { name, size = 18, class: className, ...rest } = Astro.props;
---

<svg
  class:list={['icon', className]}
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...rest}
  set:html={icons[name]}
/>

<style>
  .icon {
    flex: none;
  }
</style>
