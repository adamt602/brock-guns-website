---
import { isCurrentPage } from './isCurrentPage';
import type { NavItem } from '@/types/navigation';

/** Desktop primary navigation bar. */
interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
const { pathname } = Astro.url;
---

<nav class="navigation" aria-label="Primary">
  {items.map((item) => (
    <a
      class="navigation__link"
      href={item.href}
      aria-current={isCurrentPage(item.href, pathname) ? 'page' : undefined}
    >
      {item.label}
    </a>
  ))}
</nav>

<style>
  .navigation {
    display: flex;
    align-items: center;
    gap: 1.625rem;
  }

  .navigation__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    border-block: 2px solid transparent;
    font-size: var(--text-base-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-on-dark-link);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease);
  }

  .navigation__link:hover,
  .navigation__link[aria-current='page'] {
    color: var(--color-white);
    border-bottom-color: var(--color-brass-light);
  }
</style>
